#!/usr/bin/env bash
# Dev shim (Linux/WSL): forwards to the Python engine in the repo venv.
# Production builds replace this with the PyInstaller onefile binary (CI).
# Tauri copies this file next to the app binary (src-tauri/target/debug/),
# so locate the repo's engine/ dir by walking up from wherever we live.
D="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
while [ "$D" != "/" ] && [ ! -f "$D/engine/main.py" ]; do
  D="$(dirname "$D")"
done
if [ ! -f "$D/engine/main.py" ]; then
  echo "findy-engine dev shim: engine/main.py not found above $0" >&2
  exit 1
fi
exec "$D/engine/.venv/bin/python" "$D/engine/main.py" "$@"
